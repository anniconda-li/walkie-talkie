# macOS 系统文件 / macOS system files
.DS_Store
.AppleDouble
.LSOverride

# 目录元数据 / Directory metadata
.directory

# 临时文件 / Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# 日志文件 / Log files
*.log

# 构建产物 / Build artifacts
build/
*.o
*.a
*.out
*.exe

# ESP-IDF 生成的输出文件 / ESP-IDF generated outputs
*.bin
*.elf
*.map
flasher_args.json

# ESP-IDF 本地配置（保留 sdkconfig.defaults）/ ESP-IDF local config (keep sdkconfig.defaults)
sdkconfig
sdkconfig.old
sdkconfig.old.*

# ESP-IDF 组件管理器缓存 / ESP-IDF component manager cache
managed_components/
dependencies.lock.changes

# ESP-IDF 工具链（本地安装时）/ ESP-IDF tools (if installed locally)
.espressif/

# CMake 生成文件 / CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python 缓存 / Python cache
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# 虚拟环境 / Virtual environment
venv/
.venv/
env/

# 语言服务器 / Language servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows 系统文件 / Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE 配置文件 / IDE config files
*.user
*.suo
*.workspace
